#!/bin/sh
set -eu

HERDR_BIN=${HERDR_BIN_PATH:-herdr}
SCRIPT_DIR=$(dirname "$0")
STATE_FILE="$SCRIPT_DIR/session-tabs.json"
POPUP_CONFIG="$SCRIPT_DIR/session.toml"
POPUP_SESSION=${HERDR_POPUP_SESSION:-herdr-popup}
POPUP_WORKSPACE_LABEL=${HERDR_POPUP_WORKSPACE_LABEL:-herdr-popup}

notify() {
  "$HERDR_BIN" notification show "Herdr popup" --body "$1" --sound request >/dev/null 2>&1 || true
}

read_state() {
  if [ -f "$STATE_FILE" ]; then
    jq -c '.tabs // {} | {tabs: .}' "$STATE_FILE" 2>/dev/null || printf '%s\n' '{"tabs":{}}'
  else
    printf '%s\n' '{"tabs":{}}'
  fi
}

write_state() {
  state=$1
  temp_file=$(mktemp "$STATE_FILE.XXXXXX")
  printf '%s\n' "$state" > "$temp_file"
  mv "$temp_file" "$STATE_FILE"
}

popup_herdr() {
  env \
    -u HERDR_SOCKET_PATH \
    -u HERDR_PANE_ID \
    -u HERDR_TAB_ID \
    -u HERDR_WORKSPACE_ID \
    -u HERDR_PLUGIN_ID \
    -u HERDR_PLUGIN_CONTEXT_JSON \
    -u HERDR_PLUGIN_CONFIG_DIR \
    HERDR_CONFIG_PATH="$POPUP_CONFIG" \
    "$HERDR_BIN" --session "$POPUP_SESSION" "$@"
}

get_popup_snapshot() {
  popup_herdr api snapshot 2>/dev/null
}

snapshot=$("$HERDR_BIN" api snapshot)
state=$(read_state)
current_workspace=$(printf '%s\n' "$snapshot" | jq -r '.result.snapshot.focused_workspace_id // empty')
focused_pane=$(printf '%s\n' "$snapshot" | jq -r '.result.snapshot.focused_pane_id // empty')

if [ -z "$current_workspace" ] || [ -z "$focused_pane" ]; then
  notify "Could not determine the current workspace."
  exit 1
fi

source_cwd=$(printf '%s\n' "$snapshot" | jq -r --arg pane "$focused_pane" '[.result.snapshot.panes[] | select(.pane_id == $pane) | (.foreground_cwd // .cwd)] | first // empty')
if [ -z "$source_cwd" ]; then
  notify "Could not determine the current pane directory."
  exit 1
fi

source_label=$(basename "$source_cwd")
if [ -z "$source_label" ] || [ "$source_label" = "/" ]; then
  source_label=$(printf '%s\n' "$snapshot" | jq -r --arg workspace "$current_workspace" '[.result.snapshot.workspaces[] | select(.workspace_id == $workspace) | .label] | first // "workspace"')
fi

popup_snapshot=$(get_popup_snapshot || printf '%s\n' '')
if [ -z "$popup_snapshot" ]; then
  popup_herdr server >/dev/null 2>&1 &
  attempts=0
  while :; do
    if popup_snapshot=$(get_popup_snapshot); then
      break
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -eq 50 ]; then
      notify "Could not start the Herdr popup session."
      exit 1
    fi
    sleep 0.1
  done
fi
popup_workspace=$(printf '%s\n' "$popup_snapshot" | jq -r --arg label "$POPUP_WORKSPACE_LABEL" '[.result.snapshot.workspaces[]? | select(.label == $label) | .workspace_id] | first // empty' 2>/dev/null || printf '%s\n' '')

if [ -z "$popup_workspace" ]; then
  created=$(popup_herdr workspace create --cwd "$source_cwd" --label "$POPUP_WORKSPACE_LABEL" --focus)
  popup_workspace=$(printf '%s\n' "$created" | jq -r '.result.workspace.workspace_id')
  popup_tab=$(printf '%s\n' "$created" | jq -r '.result.tab.tab_id')
  popup_herdr tab rename "$popup_tab" "$source_label" >/dev/null
else
  popup_tab=$(printf '%s\n' "$state" | jq -r --arg workspace "$current_workspace" '[.tabs | to_entries[] | select(.value.workspace_id == $workspace) | .key] | first // empty')
  if [ -n "$popup_tab" ]; then
    tab_exists=$(printf '%s\n' "$popup_snapshot" | jq -r --arg tab "$popup_tab" '[.result.snapshot.tabs[] | select(.tab_id == $tab)] | length')
    if [ "$tab_exists" -eq 0 ]; then
      popup_tab=""
    fi
  fi
  if [ -z "$popup_tab" ]; then
    popup_tab=$(printf '%s\n' "$popup_snapshot" | jq -r --arg workspace "$popup_workspace" --arg label "$source_label" '[.result.snapshot.tabs[] | select(.workspace_id == $workspace and .label == $label) | .tab_id] | first // empty')
  fi

  if [ -n "$popup_tab" ]; then
    popup_herdr tab focus "$popup_tab" >/dev/null
  else
    created=$(popup_herdr tab create --workspace "$popup_workspace" --cwd "$source_cwd" --label "$source_label" --focus)
    popup_tab=$(printf '%s\n' "$created" | jq -r '.result.tab.tab_id')
  fi
fi

state=$(printf '%s\n' "$state" | jq -c \
  --arg tab "$popup_tab" \
  --arg workspace "$current_workspace" \
  --arg cwd "$source_cwd" \
  --arg label "$source_label" \
  '.tabs[$tab] = {workspace_id: $workspace, cwd: $cwd, label: $label}')
write_state "$state"

popup_herdr
