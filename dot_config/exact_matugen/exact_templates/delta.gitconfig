# Generated by matugen. Do not edit by hand.
# Enable in your ~/.gitconfig (filename is irrelevant; delta discovers the
# [delta "matugen"] feature once this file is included):
#   [include]
#       path = ~/.config/delta/matugen.gitconfig
#   [delta]
#       features = matugen
[delta "matugen"]
    dark = true
    line-numbers = true
    side-by-side = true
    keep-plus-minus-markers = false
    syntax-theme = matugen
    # -- file header
    file-style = "{{ base16.base05.default.hex }}" bold
    file-decoration-style = "{{ colors.outline.default.hex }}" ul
    file-added-label = [+]
    file-copied-label = [*]
    file-modified-label = [~]
    file-removed-label = [-]
    file-renamed-label = [→]
    hunk-header-style = omit
    # -- line numbers
    line-numbers-left-style = "{{ colors.outline.default.hex }}"
    line-numbers-right-style = "{{ colors.outline.default.hex }}"
    line-numbers-minus-style = "{{ colors.error.default.hex }}" italic
    line-numbers-plus-style = "{{ colors.primary.default.hex }}" italic
    line-numbers-zero-style = "{{ colors.on_surface_variant.default.hex }}"
    # -- diff
    minus-style = syntax "{{ colors.error_container.default.hex }}"
    minus-emph-style = "{{ colors.surface.default.hex }}" "{{ colors.on_error_container.default.hex }}"
    minus-non-emph-style = syntax
    plus-style = syntax "{{ colors.primary_container.default.hex }}"
    plus-emph-style = "{{ colors.surface.default.hex }}" "{{ colors.on_primary_container.default.hex }}"
    plus-non-emph-style = syntax
    zero-style = syntax
    # -- blame
    blame-code-style = syntax
    blame-format = "{author:<18} ({commit:>9}) {timestamp:^16}"
    blame-palette = "{{ colors.background.default.hex }}" "{{ colors.surface.default.hex }}" "{{ colors.outline_variant.default.hex }}" "{{ colors.surface_variant.default.hex }}"
    # -- merge conflicts
    merge-conflict-begin-symbol = "<<<"
    merge-conflict-end-symbol = ">>>"
    merge-conflict-ours-diff-header-style = "{{ base16.base0a.default.hex }}" bold
    merge-conflict-ours-diff-header-decoration-style = "{{ colors.outline.default.hex }}" box
    merge-conflict-theirs-diff-header-style = "{{ base16.base0a.default.hex }}" bold
    merge-conflict-theirs-diff-header-decoration-style = "{{ colors.outline.default.hex }}" box
