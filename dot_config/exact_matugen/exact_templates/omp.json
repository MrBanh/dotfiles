{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/theme-schema.json",
  "name": "matugen",
  "vars": {
    "bg": "{{ base16.base00.default.hex }}",
    "bgRaised": "{{ base16.base01.default.hex }}",
    "bgPanel": "{{ base16.base02.default.hex }}",
    "border": "{{ base16.base02.default.hex }}",
    "borderMuted": "{{ base16.base03.default.hex }}",
    "dim": "{{ base16.base03.default.hex }}",
    "muted": "{{ base16.base04.default.hex }}",
    "fg": "{{ base16.base05.default.hex }}",
    "red": "{{ base16.base08.default.hex }}",
    "orange": "{{ base16.base09.default.hex }}",
    "yellow": "{{ base16.base0a.default.hex }}",
    "green": "{{ base16.base0b.default.hex }}",
    "cyan": "{{ base16.base0c.default.hex }}",
    "blue": "{{ base16.base0d.default.hex }}",
    "purple": "{{ base16.base0e.default.hex }}",
    "secondaryContainer": "{{ colors.secondary_container.default.hex }}"
  },
  "colors": {
    "accent": "green",
    "border": "border",
    "borderAccent": "green",
    "borderMuted": "borderMuted",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "muted",
    "dim": "dim",
    "text": "",
    "thinkingText": "muted",

    "selectedBg": "",
