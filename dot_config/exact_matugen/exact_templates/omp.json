    "userMessageText": "fg",
    "customMessageBg": "",
    "customMessageText": "",
    "customMessageLabel": "purple",
    "toolPendingBg": "",
    "toolSuccessBg": "",
    "toolErrorBg": "",
    "toolTitle": "",
    "toolOutput": "muted",

    "mdHeading": "green",
    "mdLink": "blue",
    "mdLinkUrl": "muted",
    "mdCode": "cyan",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "borderMuted",
    "mdQuote": "muted",
    "mdQuoteBorder": "borderMuted",
    "mdHr": "borderMuted",
    "mdListBullet": "green",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
