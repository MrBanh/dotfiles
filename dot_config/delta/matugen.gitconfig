# Generated by matugen. Do not edit by hand.
# Enable in your ~/.gitconfig (filename is irrelevant; delta discovers the
# [delta "matugen"] feature once this file is included):
#   [include]
#       path = ~/.config/delta/matugen.gitconfig
#   [delta]
#       features = matugen
[delta "matugen"]
    dark = true
    line-numbers = true
    side-by-side = true
    keep-plus-minus-markers = false
    syntax-theme = matugen
    # -- file header
    file-style = "#d3c6aa" bold
    file-decoration-style = "#4e565c" ul
    file-added-label = [+]
    file-copied-label = [*]
    file-modified-label = [~]
    file-removed-label = [-]
    file-renamed-label = [→]
    hunk-header-style = omit
    # -- line numbers
    line-numbers-left-style = "#4e565c"
    line-numbers-right-style = "#4e565c"
    line-numbers-minus-style = "#e67e80" italic
    line-numbers-plus-style = "#83c092" italic
    line-numbers-zero-style = "#656d73"
    # -- diff
    minus-style = syntax "#452132"
    minus-emph-style = "#2b3339" "#e67e80"
    minus-non-emph-style = syntax
    plus-style = syntax "#213c45"
    plus-emph-style = "#2b3339" "#83c092"
    plus-non-emph-style = syntax
    zero-style = syntax
    # -- blame
    blame-code-style = syntax
    blame-format = "{author:<18} ({commit:>9}) {timestamp:^16}"
    blame-palette = "#272f35" "#2b3339" "#3a4248" "#3d454b"
    # -- merge conflicts
    merge-conflict-begin-symbol = "<<<"
    merge-conflict-end-symbol = ">>>"
    merge-conflict-ours-diff-header-style = "#dbbc7f" bold
    merge-conflict-ours-diff-header-decoration-style = "#4e565c" box
    merge-conflict-theirs-diff-header-style = "#dbbc7f" bold
    merge-conflict-theirs-diff-header-decoration-style = "#4e565c" box
