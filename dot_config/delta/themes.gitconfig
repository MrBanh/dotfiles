# In gitconfig:
#
# [include]
#     path = PATH/TO/delta/themes.gitconfig
#
# [delta]
#    features = kingfisher

[delta "everforest"]
    dark = true
    line-numbers = true
    side-by-side = true
    keep-plus-minus-markers = false
    syntax-theme = everforest
    # -- file header
    file-style = "#d3c6aa" bold
    file-decoration-style = "#4f585e" ul
    file-added-label = [+]
    file-copied-label = [*]
    file-modified-label = [~]
    file-removed-label = [-]
    file-renamed-label = [→]
    hunk-header-style = omit
    # -- line numbers
    line-numbers-left-format = " {nm:>3} │"
    line-numbers-left-style = "#e67e80"
    line-numbers-right-format = " {np:>3} │"
    line-numbers-right-style = "#83c092"
    line-numbers-minus-style = "#e67e80" italic
    line-numbers-plus-style = "#83c092" italic
    line-numbers-zero-style = "#7a8478" italic
    # -- diff
    minus-style = "#e67e80" "#4C3743"
    minus-emph-style = "#e67e80" "#4C3743"
    minus-non-emph-style = syntax
    plus-style = "#83c092" "#3C4841"
    plus-emph-style = "#83c092" "#3C4841"
    plus-non-emph-style = syntax
    zero-style = syntax
    # -- blame
    blame-code-style = syntax
    blame-format = "{author:<18} ({commit:>9}) {timestamp:^16}"
    blame-palette = "#232a2e" "#2d353b" "#343f44" "#3d484d"
    # -- merge conflicts
    merge-conflict-begin-symbol = "<<<"
    merge-conflict-end-symbol = ">>>"
    merge-conflict-ours-diff-header-style = "#dbbc7f" bold
    merge-conflict-ours-diff-header-decoration-style = "#4f585e" box
    merge-conflict-theirs-diff-header-style = "#dbbc7f" bold
    merge-conflict-theirs-diff-header-decoration-style = "#4f585e" box
